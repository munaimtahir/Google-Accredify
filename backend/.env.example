# AccrediFy backend environment template
#
# Usage:
#   cp backend/.env.example backend/.env
#
# Generate DJANGO_SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

############################
# Django Core
############################
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,172.237.95.120

# IMPORTANT:
# - For production (DEBUG=False), DATABASE_URL must be set (PostgreSQL recommended)
# - For local dev you can omit DATABASE_URL to use SQLite
DATABASE_URL=

############################
# CORS / CSRF
############################
# Comma-separated list of allowed browser origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://172.237.95.120,https://172.237.95.120

# If you serve the frontend over HTTPS with a domain/IP, add it here (comma-separated)
# Example: https://172.237.95.120,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=

############################
# AI / External Services
############################
GEMINI_API_KEY=

############################
# Upload Limits
############################
# 10MB default
MAX_UPLOAD_SIZE=10485760

############################
# Security (production)
############################
# Only applies when DEBUG=False (see settings.py)
SECURE_SSL_REDIRECT=False

############################
# Logging
############################
DJANGO_LOG_LEVEL=INFO

############################
# Error tracking (optional)
############################
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05

############################
# Caching (optional)
############################
REDIS_URL=
AI_CACHE_TTL=3600
