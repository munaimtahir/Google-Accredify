# AccrediFy Docker Compose environment template
#
# Copy to `compose.env` (gitignored) and set real values:
#   cp compose.env.example compose.env
#   docker compose --env-file compose.env --profile production up -d --build
#
# NOTE: Do not commit real secrets (DB_PASSWORD, DJANGO_SECRET_KEY, GEMINI_API_KEY).

# Database (required for docker-compose.yml)
DB_PASSWORD=change-me

# Django (required)
DJANGO_SECRET_KEY=change-me
DEBUG=False

# Gemini AI (optional; enables AI endpoints)
GEMINI_API_KEY=

# Hosts / CORS (adjust for your domain/IP)
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend (Vite) points at the backend API
VITE_API_URL=http://127.0.0.1:8000/api


