# AccrediFy Frontend Environment Variables
# Copy this file to .env.local for local development or .env.production for production builds

# API Configuration
# Backend API base URL (without trailing slash)
# Development: http://localhost:8000/api
# Production: https://api.yourdomain.com/api
VITE_API_URL=http://localhost:8000/api

# Google Gemini API Key
# Get your API key from: https://ai.google.dev/
# This is used for AI-powered features in the frontend
GEMINI_API_KEY=your_gemini_api_key_here
