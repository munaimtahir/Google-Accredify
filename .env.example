# AccrediFy environment template (root)
#
# Common usage:
# - Local frontend dev: copy to `.env.local` and edit
# - Production frontend build: copy to `.env.production` and edit
# - Docker Compose: copy to `.env` (root) and edit (DB_PASSWORD is required)
#
# NOTE:
# - Never commit real secrets. Keep `.env`, `.env.local`, `.env.production`, `backend/.env` out of git.

############################
# Frontend (Vite)
############################

# Base URL of backend API (must include `/api`)
# Local (Django dev server): http://127.0.0.1:8000/api
# VPS (direct):             http://172.237.95.120/api
# VPS (TLS via nginx):      https://172.237.95.120/api
VITE_API_URL=http://127.0.0.1:8000/api

# Optional: browser-side Gemini key (only if you intentionally call Gemini directly from frontend)
# If you prefer server-side only, leave this blank and set GEMINI_API_KEY in backend/.env instead.
GEMINI_API_KEY=

############################
# Docker Compose (root .env)
############################

# Postgres container credentials (used by docker-compose.yml)
DB_NAME=accredify_db
DB_USER=accredify_user

# REQUIRED for docker-compose up (no default)
DB_PASSWORD=change-me

# Django secret (passed to backend container)
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# Backend runtime config (passed to backend container)
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,172.237.95.120

# CORS origins allowed to call the API
# Include your frontend origin(s) (scheme + host + port), comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://172.237.95.120,https://172.237.95.120

# Backend Gemini key (server-side)
GEMINI_API_KEY=

# Optional Redis (docker-compose has redis under production profile)
REDIS_URL=redis://redis:6379/1

# Optional error tracking
SENTRY_DSN=
